{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/unixpilot-activate.py\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT\hooks\unixpilot-activate.py\"",
            "timeout": 5,
            "statusMessage": "UnixPilot ready..."
          }
        ]
      }
    ]
  }
}
